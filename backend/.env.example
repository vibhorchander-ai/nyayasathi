# Copy to backend/.env. Keys remain in the Python server, never the browser.
NYAYA_EMBEDDINGS=bge
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Best-effort, per-process daily cap. Stay on Groq's FREE tier.
NYAYA_DAILY_AI_LIMIT=100
# Optional on localhost; required before exposing a backend with an LLM key.
# Use the same random value as NYAYA_BACKEND_TOKEN in the web app's .dev.vars.
NYAYA_API_TOKEN=
NYAYA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
